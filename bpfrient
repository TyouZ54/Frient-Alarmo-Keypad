blueprint:
  name: "Clavier Frient avec centrale d'alarme (ex : Alarmo)"
  description:
    "Ce blueprint synchronise une centrale d'alarme avec un clavier Zigbee2MQTT.\n
    L'état de la centrale est transmis au clavier, et inversement.\n
    En cas de code invalide, le clavier reçoit plusieurs signaux d'erreur (bips)."
  domain: automation
  homeassistant:
    min_version: 2024.10.0
  input:
    keypad_mqtt:
      name: MQTT du clavier
      description: "Configurez les topics MQTT du clavier et gérez les codes d'accès ou badges RFID."
      icon: mdi:dialpad
      collapsed: false
      input:
        z2m_keypad_path:
          name: Topic d'état MQTT de votre clavier Zigbee2MQTT
          description:
            "Le topic d'état se compose du base_topic de Zigbee2MQTT (voir la
            configuration de votre add-on Z2M) et du nom d'affichage (Friendly Name)
            de votre clavier dans Z2M.\n
            Exemple : zigbee2mqtt/Keypad"
        z2m_keypad_path_set:
          name: Topic « set » MQTT de votre clavier Zigbee2MQTT
          description:
            "C'est le même que le topic d'état, avec /set en plus.\n
            Exemple : zigbee2mqtt/Keypad/set"
        pin_list:
          name: Liste des codes du clavier
          description:
            "Liste des codes PIN et badges RFID acceptés par le clavier,
            séparés par des points-virgules « ; ».\n
            Vous pouvez saisir un code PIN ou un badge RFID.\n
            Exemple : 1234; +ACF5678B"
        invalid_code_beeps:
          name: Nombre de signaux d'erreur (bips) si code invalide
          description: "Nombre de fois où le signal « code invalide » est envoyé au clavier (1 à 5)."
          default: 3
          selector:
            number:
              min: 1
              max: 5
              step: 1
              mode: slider
    control_panel:
      name: Centrale d'alarme
      description: "Réglages de la centrale d'alarme et des actions déclenchées par ses changements d'état."
      icon: mdi:shield-lock
      collapsed: false
      input:
        control_panel:
          name: Centrale d'alarme
          description: "Une centrale d'alarme. \nExemple : Alarmo ou https://www.home-assistant.io/integrations/manual"
          default: []
          selector:
            entity:
              domain:
                - alarm_control_panel
              multiple: false
        pin_control_panel:
          name: Code de la centrale d'alarme
          description: Code PIN valide utilisé pour piloter la centrale d'alarme.
    alarmo_actions:
      name: Actions déclenchées par un changement d'état de la centrale
      description: "Définissez les actions à exécuter à chaque changement d'état de la centrale (armée, désarmée, déclenchée, etc.)."
      icon: mdi:shield-alert
      collapsed: true
      input:
        action_arming:
          name: Action « Armement en cours »
          description:
            Action à exécuter lorsque la centrale passe à l'état « armement en cours ».
          default: []
          selector:
            action: {}
        action_armed_home:
          name: Action « Armée maison »
          description:
            Action à exécuter lorsque la centrale passe à l'état « armée maison ».
          default: []
          selector:
            action: {}
        action_armed_night:
          name: Action « Armée nuit »
          description:
            Action à exécuter lorsque la centrale passe à l'état « armée nuit ».
          default: []
          selector:
            action: {}
        action_armed_away:
          name: Action « Armée absence »
          description:
            Action à exécuter lorsque la centrale passe à l'état « armée absence ».
          default: []
          selector:
            action: {}
        action_disarmed:
          name: Action « Désarmée »
          description:
            Action à exécuter lorsque la centrale passe à l'état « désarmée ».
          default: []
          selector:
            action: {}
        action_pending:
          name: Action « En attente »
          description:
            Action à exécuter lorsque la centrale passe à l'état « en attente » (délai d'entrée).
          default: []
          selector:
            action: {}
        action_panic:
          name: Action « Panique »
          description:
            Action à exécuter lorsque le bouton panique / SOS du clavier est
            pressé.
          default: []
          selector:
            action: {}
        action_alarm:
          name: Action « Alarme »
          description: Action à exécuter lorsque l'alarme est déclenchée.
          default: []
          selector:
            action: {}
    custom_action_1:
      name: Code spécial 1
      description: "Définissez une action spécifique déclenchée lorsque le code 1 est saisi (code + une touche d'armement ou de désarmement). Ce code est prioritaire : s'il figure aussi dans la liste des codes du clavier, seule l'action spéciale est exécutée."
      icon: mdi:gesture-tap-button
      collapsed: true
      input:
        custom_pincode_1:
          name: Code 1
          description: "Saisissez le code qui déclenchera l'action 1 depuis le clavier."
          default: ""
        custom_action_1:
          name: Action du code 1
          description: "Action à exécuter lorsque le code 1 est saisi sur le clavier."
          default: []
          selector:
            action: {}
    custom_action_2:
      name: Code spécial 2
      description: "Définissez une action spécifique déclenchée lorsque le code 2 est saisi (code + une touche d'armement ou de désarmement). Ce code est prioritaire : s'il figure aussi dans la liste des codes du clavier, seule l'action spéciale est exécutée."
      icon: mdi:gesture-tap-button
      collapsed: true
      input:
        custom_pincode_2:
          name: Code 2
          description: "Saisissez le code qui déclenchera l'action 2 depuis le clavier."
          default: ""
        custom_action_2:
          name: Action du code 2
          description: "Action à exécuter lorsque le code 2 est saisi sur le clavier."
          default: []
          selector:
            action: {}
    custom_action_3:
      name: Code spécial 3
      description: "Définissez une action spécifique déclenchée lorsque le code 3 est saisi (code + une touche d'armement ou de désarmement). Ce code est prioritaire : s'il figure aussi dans la liste des codes du clavier, seule l'action spéciale est exécutée."
      icon: mdi:gesture-tap-button
      collapsed: true
      input:
        custom_pincode_3:
          name: Code 3
          description: "Saisissez le code qui déclenchera l'action 3 depuis le clavier."
          default: ""
        custom_action_3:
          name: Action du code 3
          description: "Action à exécuter lorsque le code 3 est saisi sur le clavier."
          default: []
          selector:
            action: {}
  source_url: https://github.com/Bygood91/frient_keypad_alarmo/blob/main/frient_keypad_with_alarmo.yaml
variables:
  pin_list_var: !input pin_list
  pin_list: "{{ pin_list_var.split(';') | map('trim') | reject('eq', '') | list }}"
  custom_pincode_1_raw: !input custom_pincode_1
  custom_pincode_2_raw: !input custom_pincode_2
  custom_pincode_3_raw: !input custom_pincode_3
  custom_pincode_1: "{{ custom_pincode_1_raw | string | trim }}"
  custom_pincode_2: "{{ custom_pincode_2_raw | string | trim }}"
  custom_pincode_3: "{{ custom_pincode_3_raw | string | trim }}"
  pin_actions_list: "{{ [custom_pincode_1, custom_pincode_2, custom_pincode_3] | reject('eq', '') | list }}"
  invalid_beeps_var: !input invalid_code_beeps
  invalid_beeps: "{{ invalid_beeps_var | int(3) }}"
  received_code: "{{ trigger.payload_json.action_code | default('', true) | string | trim if trigger.platform == 'mqtt' and trigger.payload_json is mapping else '' }}"
  received_action: "{{ trigger.payload_json.action | default('', true) if trigger.platform == 'mqtt' and trigger.payload_json is mapping else '' }}"
triggers:
  - trigger: state
    entity_id: !input control_panel
    to: arming
    id: panel_arming
  - trigger: state
    entity_id: !input control_panel
    to: armed_home
    id: panel_armed_home
  - trigger: state
    entity_id: !input control_panel
    to: armed_night
    id: panel_armed_night
  - trigger: state
    entity_id: !input control_panel
    to: disarmed
    id: panel_disarmed
  - trigger: state
    entity_id: !input control_panel
    to: armed_away
    id: panel_armed_away
  - trigger: state
    entity_id: !input control_panel
    to: pending
    id: panel_pending
  - trigger: state
    entity_id: !input control_panel
    to: triggered
    id: panel_triggered
  - trigger: mqtt
    topic: !input z2m_keypad_path
    id: keypad_mqtt
condition: []
actions:
  - choose:
      # ---------- Centrale -> Clavier ----------
      - conditions:
          - condition: trigger
            id: panel_arming
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n\"arm_mode\": \n  {\n  \"mode\": \"exit_delay\"\n  }\n}"
          - sequence: !input action_arming
      - conditions:
          - condition: trigger
            id: panel_armed_away
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n   \"mode\": \"arm_all_zones\"\n  }\n}"
          - sequence: !input action_armed_away
      - conditions:
          - condition: trigger
            id: panel_disarmed
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n    \"mode\": \"disarm\"\n  }\n}"
          - sequence: !input action_disarmed
      - conditions:
          - condition: trigger
            id: panel_armed_home
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n   \"mode\": \"arm_day_zones\"\n  }\n}"
          - sequence: !input action_armed_home
      - conditions:
          - condition: trigger
            id: panel_armed_night
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n   \"mode\": \"arm_night_zones\"\n  }\n}"
          - sequence: !input action_armed_night
      - conditions:
          - condition: trigger
            id: panel_pending
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n   \"mode\": \"entry_delay\"\n  }\n}"
          - sequence: !input action_pending
      - conditions:
          - condition: trigger
            id: panel_triggered
        sequence:
          - action: mqtt.publish
            data:
              topic: !input z2m_keypad_path_set
              payload: "{\n \"arm_mode\": \n  {\n   \"mode\": \"in_alarm\"\n  }\n}"
          - sequence: !input action_alarm
      # ---------- Clavier -> Centrale ----------
      - conditions:
          - condition: trigger
            id: keypad_mqtt
        sequence:
          - choose:
              # Codes spéciaux (prioritaires)
              - conditions:
                  - condition: template
                    value_template: "{{ custom_pincode_1 != '' and received_code == custom_pincode_1 }}"
                sequence: !input custom_action_1
              - conditions:
                  - condition: template
                    value_template: "{{ custom_pincode_2 != '' and received_code == custom_pincode_2 }}"
                sequence: !input custom_action_2
              - conditions:
                  - condition: template
                    value_template: "{{ custom_pincode_3 != '' and received_code == custom_pincode_3 }}"
                sequence: !input custom_action_3
              # Codes valides : armement / désarmement
              - conditions:
                  - condition: template
                    value_template: '{{ received_code in pin_list and received_action == "arm_all_zones" }}'
                sequence:
                  - action: alarm_control_panel.alarm_arm_away
                    target:
                      entity_id: !input control_panel
                    data:
                      code: !input pin_control_panel
              - conditions:
                  - condition: template
                    value_template: '{{ received_code in pin_list and received_action == "arm_day_zones" }}'
                sequence:
                  - action: alarm_control_panel.alarm_arm_home
                    target:
                      entity_id: !input control_panel
                    data:
                      code: !input pin_control_panel
              - conditions:
                  - condition: template
                    value_template: '{{ received_code in pin_list and received_action == "arm_night_zones" }}'
                sequence:
                  - action: alarm_control_panel.alarm_arm_night
                    target:
                      entity_id: !input control_panel
                    data:
                      code: !input pin_control_panel
              - conditions:
                  - condition: template
                    value_template: '{{ received_code in pin_list and received_action == "disarm" }}'
                sequence:
                  - action: alarm_control_panel.alarm_disarm
                    target:
                      entity_id: !input control_panel
                    data:
                      code: !input pin_control_panel
              # Bouton panique
              - conditions:
                  - condition: template
                    value_template: '{{ received_action == "emergency" }}'
                sequence: !input action_panic
              # Code invalide : plusieurs signaux d'erreur (bips)
              - conditions:
                  - condition: template
                    value_template: "{{ received_code not in pin_list and received_code not in pin_actions_list and received_code | int(-1) != -1 }}"
                sequence:
                  - repeat:
                      count: "{{ invalid_beeps }}"
                      sequence:
                        - action: mqtt.publish
                          data:
                            topic: !input z2m_keypad_path_set
                            payload:
                              "{\n \"arm_mode\": \n  {\n   \"transaction\": \"{{ trigger.payload_json.action_transaction
                              }}\",\n   \"mode\": \"invalid_code\"\n  }\n}"
                        - delay:
                            milliseconds: 600
            default: []
    default: []
mode: parallel
max: 10
